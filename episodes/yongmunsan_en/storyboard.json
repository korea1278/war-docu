    "kb": "in"
   },
   "label": "Dramatization"
  },
  {
   "id": "s03",
   "lines": [
    "\"The enemy ahead is the same division we shattered a month ago.\""
   ],
   "visual": {
    "type": "ai",
    "img": "pva_commander",
    "kb": "in2",
    "bubbles": [
